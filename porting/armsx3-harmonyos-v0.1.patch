+// OHOS runs its special handlers (including the crash reporter) before the
+// handler installed through sigaction. Guest write-protection faults must be
+// consumed there, before the crash reporter treats them as fatal.
+struct ohos_signal_chain_action
+{
+	bool (*handler)(int, siginfo_t*, void*);
+	sigset_t mask;
