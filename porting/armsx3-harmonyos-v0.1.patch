+static bool ohos_guest_fault(int sig, siginfo_t* info, void* context)
+{
+	if (sig != SIGSEGV || !info || !thread_ctrl::get_current()) return false;
+	const u64 exec = (reinterpret_cast<u64>(info->si_addr) - reinterpret_cast<u64>(vm::g_exec_addr)) / 2;
