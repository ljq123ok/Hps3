+	if (!vm::try_get_addr(info->si_addr).second && exec >= 0x100000000ull && seg >= 0x80000000ull)
+		return false;
+	signal_handler(sig, info, context);
+	g_ohos_recovered_faults.fetch_add(1, std::memory_order_relaxed);
+	return true;
+}
